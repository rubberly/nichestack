# Copy this file to .env and fill it in. Never commit .env (it's git-ignored).

# ── Database ────────────────────────────────────────────────────────────────
# Local: run `npm run db:start` in its own terminal and keep this value.
# Production: a free Neon Postgres URL (https://neon.tech), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nichestack"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Public URL of the app (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"
# Comma-separated emails that can open /admin
ADMIN_EMAILS="you@example.com"

# ── Email (Resend, free 3,000/month) ────────────────────────────────────────
# Leave RESEND_API_KEY empty locally: login links and emails print in the terminal.
RESEND_API_KEY=""
EMAIL_FROM="Nichestack <login@yourdomain.com>"
SUPPORT_EMAIL="support@yourdomain.com"

# ── Stripe (TEST MODE ONLY: keys start with sk_test_) ───────────────────────
# Dashboard → Developers → API keys (toggle "Test mode")
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (local) or the webhook page (prod)
STRIPE_WEBHOOK_SECRET=""
# Live keys are refused unless this is "true". Leave false until a real launch.
ALLOW_LIVE_STRIPE="false"
