# Copy this file to .env and fill it in. Never commit .env (it's git-ignored).

# ── Database ────────────────────────────────────────────────────────────────
# Local: run `npm run db:start` in its own terminal and keep this value.
# Production: a free Neon Postgres URL (https://neon.tech), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nichestack"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Public URL of the app (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"
# Comma-separated emails that can open /admin
ADMIN_EMAILS="you@example.com"

# ── Email (Resend, free 3,000/month) ────────────────────────────────────────
# Leave RESEND_API_KEY empty locally: login links and emails print in the terminal.
RESEND_API_KEY=""
EMAIL_FROM="Nichestack <login@yourdomain.com>"
SUPPORT_EMAIL="support@yourdomain.com"

# ── Stripe (TEST MODE ONLY: keys start with sk_test_) ───────────────────────
# Dashboard → Developers → API keys (toggle "Test mode")
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (local) or the webhook page (prod)
STRIPE_WEBHOOK_SECRET=""
# Live keys are refused unless this is "true". Leave false until a real launch.
ALLOW_LIVE_STRIPE="false"

# ── Storage Facility: rent collection (Stripe Connect Express) ──────────────
# Turn on Connect once in the Stripe dashboard (test mode): Settings → Connect → Get started.
# Your cut of every card rent payment, in % (shown to owners on their payments page).
PLATFORM_FEE_PERCENT="1"
# Card processing passed through at cost. Stripe charges these to YOUR account on destination
# charges, so they're added to the application fee. Match your Stripe pricing.
CARD_FEE_PERCENT="2.9"
CARD_FEE_FIXED_CENTS="30"

# ── Daily job (late-rent reminders, releasing abandoned bookings) ───────────
# Any long random string. Vercel Cron sends it automatically; locally, call:
#   curl -H "Authorization: Bearer <CRON_SECRET>" http://localhost:3000/api/cron/daily
CRON_SECRET=""
