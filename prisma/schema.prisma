generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js tables
// ---------------------------------------------------------------------------

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  emailVerified   DateTime?
  image           String?
  isPlatformAdmin Boolean      @default(false)
  createdAt       DateTime     @default(now())
  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Core platform (Phase 1)
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Product {
  FACILITY
  PORTAL
  PHOTOVAULT
  QUOTEFOLLOW
}

model Org {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  stripeCustomerId    String?        @unique
  storageUsedBytes    BigInt         @default(0)
  // Branding (used by the client portal, Phase 3)
  logoKey             String?
  brandColor          String?
  settings            Json           @default("{}")
  createdAt           DateTime       @default(now())
  // Stripe Connect Express account that receives rent (Phase 2)
  connectAccountId    String?        @unique
  connectChargesReady Boolean        @default(false)
  memberships         Membership[]
  invites             Invite[]
  subscriptions       Subscription[]
  auditLogs           AuditLog[]
  facilities          Facility[]
  units               Unit[]
  contacts            Contact[]
  leases              Lease[]
  rentPayments        RentPayment[]
  messageLogs         MessageLog[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role      @default(MEMBER)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Subscription {
  id                   String    @id @default(cuid())
  orgId                String
  product              Product
  planKey              String
  interval             String    @default("month") // "month" | "year"
  status               String // Stripe status: trialing, active, past_due, canceled, ...
  stripeSubscriptionId String    @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  org                  Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, product])
}

model StripeEvent {
  id        String   @id // Stripe event id: makes webhooks idempotent
  type      String
  createdAt DateTime @default(now())
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 2: Storage Facility
// ---------------------------------------------------------------------------

enum UnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  PENDING // booked online, waiting for first payment
  ACTIVE
  ENDED
}

model Facility {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  slug           String   @unique // public booking page: /book/[slug]
  address        String   @default("")
  phone          String   @default("")
  email          String   @default("")
  graceDays      Int      @default(5) // days after due before a tenant counts as overdue
  bookingEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  units          Unit[]

  @@index([orgId])
}

model Unit {
  id                String     @id @default(cuid())
  orgId             String
  facilityId        String
  label             String // "A12"
  size              String     @default("") // "10x10"
  monthlyPriceCents Int
  status            UnitStatus @default(AVAILABLE)
  notes             String     @default("")
  createdAt         DateTime   @default(now())
  org               Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  facility          Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  leases            Lease[]

  @@unique([facilityId, label])
  @@index([orgId, status])
}

/// An org's own customer (a tenant here; a portal client in Phase 3).
model Contact {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String
  phone     String   @default("")
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leases    Lease[]

  @@unique([orgId, email])
}

model Lease {
  id                   String        @id @default(cuid())
  orgId                String
  unitId               String
  contactId            String
  status               LeaseStatus   @default(PENDING)
  source               String        @default("manual") // manual | booking | import
  startDate            DateTime
  endDate              DateTime?
  monthlyRentCents     Int
  paidThrough          DateTime // rent is covered up to (not including) this date
  payToken             String        @unique // public pay link: /pay/[token]
  autopay              Boolean       @default(false)
  stripeSubscriptionId String?       @unique
  createdAt            DateTime      @default(now())
  org                  Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit                 Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contact              Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  payments             RentPayment[]

  @@index([orgId, status])
}

model RentPayment {
  id               String   @id @default(cuid())
  orgId            String
  leaseId          String
  amountCents      Int
  platformFeeCents Int      @default(0)
  months           Int      @default(1)
  method           String // card | autopay | cash | check | other
  stripeRef        String?  @unique // invoice or checkout session id: makes webhooks idempotent
  paidAt           DateTime @default(now())
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease            Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([orgId, paidAt])
}

model MessageLog {
  id       String   @id @default(cuid())
  orgId    String
  leaseId  String?
  channel  String   @default("email")
  to       String
  template String // e.g. "late:5:2026-11-01" (step + paidThrough, so each step sends once per missed month)
  sentAt   DateTime @default(now())
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([leaseId, template])
  @@index([orgId, sentAt])
}
